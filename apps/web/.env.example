# Neon / Postgres (también en packages/db/.env para Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3603"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="same-as-NEXTAUTH_SECRET"

# Admin seed (desde la raíz: npm run db:seed)
ADMIN_EMAIL="admin@oct3d.local"
ADMIN_PASSWORD="cambiá-esto"

NEXT_PUBLIC_APP_URL="http://localhost:3603"
