{
  "name": "oct3d",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @oct3d/web",
    "build": "npm run build -w @oct3d/db && npm run build -w @oct3d/web",
    "start": "npm run start -w @oct3d/web",
    "lint": "npm run lint -w @oct3d/web",
    "db:generate": "npm run generate -w @oct3d/db",
    "db:push": "npm run push -w @oct3d/db",
    "db:seed": "npm run seed -w @oct3d/db"
  }
}
